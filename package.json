{
  "name": "tournament-scheduler",
  "version": "3.0.0",
  "description": "鍗＄墝璧涗簨缂栨帓 鈥斺€?鐟炲＋杞?/ 鍗曡触 / 鍙岃触 / 寰幆璧?/ 澶氶樁娈靛皬缁勮禌",
  "main": "electron/main.js",
  "author": "",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node tools/run_tests.js",
    "test:smoke": "node tools/run_tests.js --smoke",
    "test:all": "node tools/run_tests.js --all",
    "test:i18n": "node tools/check_i18n.js",
    "i18n:scan": "node tools/extract_i18n.js --zh",
    "dist:exe": "electron-builder --win --x64",
    "dist:portable": "electron-builder --win --x64 --config.win.target=portable",
    "cap:add": "cap add android",
    "cap:sync": "cap sync android",
    "apk:debug": "cd android && gradlew.bat assembleDebug",
    "apk:release": "cd android && gradlew.bat assembleRelease"
  },
  "devDependencies": {
    "electron": "^30.5.1",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/core": "^6.1.2"
  },
  "optionalDependencies": {
    "@capacitor/cli": "^6.1.2"
  },
  "build": {
    "appId": "com.local.tournament",
    "productName": "鍗＄墝璧涗簨缂栨帓",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "app/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
